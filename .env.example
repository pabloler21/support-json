# Plantilla de variables de entorno.
# Copiar a .env y completar. NO poner credenciales reales en este archivo.

# Obligatoria: clave de la API de OpenAI.
OPENAI_API_KEY=

# Configuración del modelo (opcionales: si se omiten se usan estos defaults).
MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_TOKENS=300

# Precios en USD por cada 1M de tokens, para estimar el costo en metrics.csv.
INPUT_COST_PER_1M_TOKENS=0.15
OUTPUT_COST_PER_1M_TOKENS=0.60
